{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ladalalious/token-metrology-standard/tms_report.schema.json",
  "title": "Token Metrology Standard (TMS) report",
  "type": "object",
  "required": ["standard", "standard_version", "corpus", "tokenizer", "measurements", "aggregates"],
  "properties": {
    "standard": { "const": "Token Metrology Standard" },
    "standard_version": { "type": "string" },
    "corpus": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "tokenizer": {
      "type": "object",
      "required": ["name", "type", "vocabulary_size", "conditions"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "vocabulary_size": { "type": "integer", "minimum": 1 },
        "conditions": {
          "type": "object",
          "required": ["normalization", "special_tokens"],
          "properties": {
            "normalization": { "type": "string" },
            "special_tokens": { "type": "string" },
            "pre_tokenizer": { "type": "string" }
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "language", "tokens", "bytes", "chars", "token_per_byte", "token_per_char"],
        "properties": {
          "id": { "type": "string" },
          "language": { "type": "string" },
          "domain": { "type": "string" },
          "tokens": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "chars": { "type": "integer", "minimum": 0 },
          "token_per_byte": { "type": "number" },
          "token_per_char": { "type": "number" }
        }
      }
    },
    "aggregates": {
      "type": "object",
      "required": ["token_inflation_factor"]
    }
  }
}
